# PRODUCTION Environment Configuration
# Deploy this to: app.meldra.ai or login.meldra.ai

# Application
NEXT_PUBLIC_APP_URL=https://app.meldra.ai
NEXT_PUBLIC_APP_NAME="meldra"
NEXT_PUBLIC_ENVIRONMENT=production

# API Configuration - Points to PRODUCTION backend
NEXT_PUBLIC_API_URL=https://api.meldra.ai

# Authentication
NEXTAUTH_URL=https://app.meldra.ai
NEXTAUTH_SECRET=your-production-nextauth-secret-MUST-CHANGE-THIS
