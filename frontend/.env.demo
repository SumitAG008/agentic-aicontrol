# DEMO Environment Configuration
# Deploy this to: demo.meldra.ai

# Application
NEXT_PUBLIC_APP_URL=https://demo.meldra.ai
NEXT_PUBLIC_APP_NAME="meldra"
NEXT_PUBLIC_ENVIRONMENT=demo

# API Configuration - Points to DEMO backend
NEXT_PUBLIC_API_URL=https://demo-api.meldra.ai

# Authentication
NEXTAUTH_URL=https://demo.meldra.ai
NEXTAUTH_SECRET=your-demo-nextauth-secret-change-this
