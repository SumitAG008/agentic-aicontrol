// Prisma schema for AI Control Room
// Supports: SQLite (default), PostgreSQL, MySQL

generator client {
  provider = "prisma-client-js"
}

// DEFAULT: SQLite (zero config, perfect for local dev)
// To use PostgreSQL or MySQL, change the provider and DATABASE_URL
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  plan      String   @default("starter")
  settings  String   @default("{}") // JSON stored as string for SQLite
  limits    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  agents Agent[]
  runs   AgentRun[]
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  avatar     String?
  role       String   @default("viewer")
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  lastLogin  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

model Agent {
  id            String   @id @default(cuid())
  name          String
  description   String?
  avatar        String?
  status        String   @default("idle")
  domainPackId  String?
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  configuration String   @default("{}")
  schedule      String   @default("{}")
  metrics       String   @default("{}")
  permissions   String   @default("[]")
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runs AgentRun[]

  @@index([tenantId])
  @@index([status])
}

model Tool {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  icon           String?
  category       String
  provider       String?
  version        String   @default("1.0.0")
  schema         String   @default("{}")
  authentication String   @default("{}")
  rateLimit      String   @default("{}")
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DomainPack {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  category    String
  version     String   @default("1.0.0")
  agents      String   @default("[]")
  tools       String   @default("[]")
  status      String   @default("active")
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgentRun {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  status    String   @default("pending")
  trigger   String   @default("manual")
  input     String   @default("{}")
  output    String?
  steps     String   @default("[]")
  error     String?
  metrics   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  action     String
  resource   String
  resourceId String
  changes    String   @default("{}")
  ip         String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
}
