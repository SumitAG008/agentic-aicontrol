# =============================================================================
# AI CONTROL ROOM - BACKEND CONFIGURATION
# =============================================================================

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE OPTIONS (Choose ONE - SQLite is the default, zero-config option)
# =============================================================================

# OPTION 1: SQLite (DEFAULT - No setup required!)
# Just use the file path - database will be created automatically
DATABASE_URL="file:./dev.db"

# OPTION 2: PostgreSQL (Free options below)
# Uncomment and set your connection string
# DATABASE_URL="postgresql://user:password@localhost:5432/ai_control_room"
#
# FREE HOSTED PostgreSQL OPTIONS:
# - Supabase:   https://supabase.com (500MB free)
# - Neon:       https://neon.tech (3GB free)
# - Railway:    https://railway.app (500MB free)
# - Vercel:     https://vercel.com/storage (256MB free with Vercel)

# OPTION 3: MySQL (Free options below)
# DATABASE_URL="mysql://user:password@localhost:3306/ai_control_room"
#
# FREE HOSTED MySQL OPTIONS:
# - PlanetScale: https://planetscale.com (5GB free)
# - Railway:     https://railway.app (500MB free)

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_SECRET=change-this-to-a-random-string-in-production
JWT_EXPIRES_IN=7d

# =============================================================================
# AI PROVIDER (Required for agent execution)
# =============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key

# =============================================================================
# OPTIONAL: Redis for queues/caching (Not required for basic setup)
# =============================================================================
# Free options: Upstash (https://upstash.com), Railway
# REDIS_URL=redis://localhost:6379

# =============================================================================
# SAP SUCCESSFACTORS INTEGRATION (For Compensation Worksheet Automation)
# =============================================================================

# SuccessFactors OData API Configuration
# Get these credentials from your SuccessFactors admin or IT team
SF_INSTANCE_URL=https://apiXXXX.successfactors.com
SF_COMPANY_ID=YourCompanyID
SF_USERNAME=your-api-username
SF_PASSWORD=your-api-password
SF_API_KEY=your-api-key-if-required

# SuccessFactors SFTP Configuration (for file-based upsert operations)
SF_SFTP_HOST=sftp.successfactors.com
SF_SFTP_PORT=22
SF_SFTP_USERNAME=your-sftp-username
SF_SFTP_PASSWORD=your-sftp-password

# OR use SSH private key authentication (recommended for production):
# SF_SFTP_PRIVATE_KEY=/path/to/private/key
# SF_SFTP_PASSPHRASE=passphrase-if-key-is-encrypted

# Remote path where compensation files should be uploaded
SF_SFTP_REMOTE_PATH=/upload/compensation
